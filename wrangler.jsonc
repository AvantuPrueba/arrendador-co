{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "arrendador-co",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-10-06",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "arrendadorco-orders",
			"database_id": "6bfbbd8d-c8fa-46eb-aa16-0c0845bce80b"
		}
	],
	"r2_buckets": [
		{
			"binding": "R2_BUCKET",
			"bucket_name": "arrendadorco-products"
		}
	]
}