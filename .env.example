# ------------------------------------------------------------------
# ArrendadorCO — variables de entorno
# Copia este archivo a `.env.local` y rellena los valores.
# `.env.local` está en `.gitignore`; NUNCA subas credenciales reales.
# ------------------------------------------------------------------

# --- Mercado Pago -------------------------------------------------
# Link de Pago de Mercado Pago (Checkout Pro).
# Se obtiene en: https://www.mercadopago.com.co/links/
# Formato esperado: https://www.mercadopago.com.co/l/XXXXXXXXXXXX
#
# OJO: el prefijo NEXT_PUBLIC_ hace que Next.js incruste el valor en el
# bundle del navegador. Es intencional (el link debe ser público), pero
# implica que debe existir ANTES de `npm run build`: los valores se
# congelan en tiempo de build, no de runtime.
NEXT_PUBLIC_MERCADOPAGO_LINK=

# Correo de soporte. Reemplaza el placeholder [PENDIENTE: correo electrónico]
# que aparece en /tienda y en las páginas legales.
# (Ver DECISIONES_PENDIENTES.md, bloque 3)
NEXT_PUBLIC_SUPPORT_EMAIL=